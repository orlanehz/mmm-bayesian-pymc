# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store

# Project artifacts
artifacts/inference/*
artifacts/metrics/*
artifacts/figures/*

# Keep artifact folders structure
!artifacts/inference/.gitkeep
!artifacts/metrics/.gitkeep
!artifacts/figures/.gitkeep

# Data files (generated / local)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Tuning artifacts (generated)
artifacts/tuning/*
!artifacts/tuning/.gitkeep
artifacts/run_config.json
